<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="jarvis.ui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS"
                    AnchorPane.topAnchor="1.0" AnchorPane.leftAnchor="1.0" AnchorPane.rightAnchor="1.0"
                    AnchorPane.bottomAnchor="50.0">
            <content>
                <VBox fx:id="dialogContainer" prefHeight="-1.0" prefWidth="-1.0"/>
            </content>
        </ScrollPane>
        <TextField fx:id="userInput" AnchorPane.bottomAnchor="1.0"
                   AnchorPane.leftAnchor="1.0" AnchorPane.rightAnchor="60.0"
                   onAction="#handleUserInput"/>
        <Button fx:id="sendButton" mnemonicParsing="false" prefWidth="55.0" text="Send"
                AnchorPane.bottomAnchor="1.0" AnchorPane.rightAnchor="1.0"
                onAction="#handleUserInput"/>
    </children>
    <padding>
        <Insets top="0.0" right="0.0" bottom="0.0" left="0.0"/>
    </padding>
</AnchorPane>
